# .gitignore — Python project + local runtime files

# Byte-compiled / caches
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.eggs/
pip-wheel-metadata/
*.egg
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# dotenv files (ignore real secrets, but allow the example)
.env
!.env.example

# Project runtime / DB state
bot/tracker.db
bot/tracker.db-journal
bot/ftp_offset.json
bot/test_tracker.db
ftp_offset.json
*.sqlite
*.sqlite3

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
scripts/

# Type / lint caches
.mypy_cache/
.pytest_cache/

# IDEs and editors
.vscode/
.idea/
*.sublime-* 
*.code-workspace
*.swp
*~
*.bak

# OS
.DS_Store
Thumbs.db

# Misc
__pypackages__/
.ropeproject/
